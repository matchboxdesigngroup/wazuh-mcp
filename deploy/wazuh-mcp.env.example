# /etc/wazuh-mcp/wazuh-mcp.env  --  chown root:wazuh-mcp, chmod 640
#
# Running on the Wazuh host means both backends are reachable over loopback,
# so 55000 and 9200 need not be exposed to the network at all.

WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-mcp
WAZUH_API_PASSWORD=

WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=wazuh-mcp
WAZUH_INDEXER_PASSWORD=

# Wazuh's certificates are issued for internal names. Over loopback the traffic
# never leaves the host, so verification adds nothing here.
WAZUH_VERIFY_SSL=false

# --- Transport -------------------------------------------------------------
WAZUH_TRANSPORT=http
WAZUH_BIND_HOST=127.0.0.1
WAZUH_BIND_PORT=8080
WAZUH_HTTP_PATH=/mcp
WAZUH_PUBLIC_URL=https://wazuh.matchbox.host/mcp

# Comma-separated. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# List two during a rotation, then drop the old one.
WAZUH_AUTH_TOKENS=

# --- Behaviour -------------------------------------------------------------
# WAZUH_ALLOW_WRITE=true
# WAZUH_LOG_LEVEL=INFO
