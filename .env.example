# --- Wazuh Manager API (agents, rules, inventory, configuration) ------------
WAZUH_API_URL=https://wazuh.example.com:55000
WAZUH_API_USER=wazuh-mcp
WAZUH_API_PASSWORD=change-me

# --- Wazuh Indexer / OpenSearch (alerts, vulnerability state) --------------
# Required for alert search, aggregations, reports and 4.8+ vulnerabilities.
WAZUH_INDEXER_URL=https://wazuh.example.com:9200
WAZUH_INDEXER_USER=wazuh-mcp
WAZUH_INDEXER_PASSWORD=change-me

# --- TLS -------------------------------------------------------------------
# Point at your Wazuh root CA rather than disabling verification.
# WAZUH_CA_BUNDLE=/etc/ssl/certs/wazuh-root-ca.pem
# WAZUH_VERIFY_SSL=false

# --- Behaviour -------------------------------------------------------------
# Leave unset (false) to keep the server read-only. Enabling this allows agent
# restarts, on-demand scans and active-response commands.
# WAZUH_ALLOW_WRITE=false

# WAZUH_TIMEOUT=30
# WAZUH_MAX_RESULTS=500
# WAZUH_ALERTS_INDEX=wazuh-alerts-*
# WAZUH_VULNERABILITY_INDEX=wazuh-states-vulnerabilities-*
# WAZUH_LOG_LEVEL=INFO
